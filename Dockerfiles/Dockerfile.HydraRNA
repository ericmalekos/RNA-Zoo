FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

LABEL org.opencontainers.image.source="https://github.com/GuipengLi/HydraRNA"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="hydrarna"
LABEL org.opencontainers.image.description="Hybrid Hydra-SSM + MHA full-length RNA language model (≤10K nt, 1024-d embeddings, GPU-only)."

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential wget ca-certificates procps && \
    rm -rf /var/lib/apt/lists/*

# Miniforge → Python 3.10 (fairseq 0.12 is compatible; cp310 has wider wheel support)
RUN wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \
        -O /tmp/miniforge.sh && \
    bash /tmp/miniforge.sh -b -p /opt/conda && \
    rm /tmp/miniforge.sh
ENV PATH="/opt/conda/bin:$PATH"

RUN mamba create -n hydrarna -c conda-forge -y \
        python=3.10 \
        "numpy<2" \
        pandas \
        cython \
        "setuptools<70" \
        pip \
    && mamba clean -afy

ENV PATH="/opt/conda/envs/hydrarna/bin:/usr/local/cuda/bin:$PATH"
ENV CONDA_DEFAULT_ENV=hydrarna

# PyTorch 2.3.1 + cu118 (matches upstream install.sh pin)
RUN /opt/conda/envs/hydrarna/bin/pip install --no-cache-dir \
        "torch==2.3.1" \
        --index-url https://download.pytorch.org/whl/cu118

# causal-conv1d, mamba-ssm, and flash-attn: prebuilt wheels for
# cu118 + torch2.3 + cp310 + cxx11abiFALSE (conda ABI). No source
# compilation needed — eliminates the 30-50 min build-time cost.
RUN /opt/conda/envs/hydrarna/bin/pip install --no-cache-dir \
        "https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.4.0/causal_conv1d-1.4.0+cu118torch2.3cxx11abiFALSE-cp310-cp310-linux_x86_64.whl" \
        "https://github.com/state-spaces/mamba/releases/download/v2.2.2/mamba_ssm-2.2.2+cu118torch2.3cxx11abiFALSE-cp310-cp310-linux_x86_64.whl" \
        "https://github.com/Dao-AILab/flash-attention/releases/download/v2.6.3/flash_attn-2.6.3+cu118torch2.3cxx11abiFALSE-cp310-cp310-linux_x86_64.whl"

# Clone HydraRNA repo (needed for dict/ and custom fairseq tasks).
# We skip `pip install fairseq` entirely — setup.py compiles C++ extensions
# (libbleu, libnat, etc.) that OOM/fail on GHA runners and are not needed for
# HydraRNA's inference path (checkpoint loading + extract_features).
# Instead, install only the Python-level deps fairseq requires.
RUN git clone --depth 1 https://github.com/GuipengLi/HydraRNA.git /opt/hydrarna_repo
# fused_dense_lib (required by fused_bias_fc=True) is not shipped in prebuilt
# flash-attn wheels — it would need full source compilation. Patch model.py to
# use fused_bias_fc=False instead: falls back to standard nn.Linear, output is
# identical, inference is ~5% slower. Weight files are unaffected.
RUN sed -i 's/fused_bias_fc=True/fused_bias_fc=False/g' \
        /opt/hydrarna_repo/fairseq/fairseq/models/hydraAttRNA/model.py
# pip >=24.1 rejects omegaconf 2.0.x as "invalid metadata", making hydra-core 1.0.7
# (which requires omegaconf>=2.0.5,<2.1) unresolvable. Pin pip<24.1 for this layer.
RUN /opt/conda/envs/hydrarna/bin/pip install --no-cache-dir "pip<24.1" && \
    /opt/conda/envs/hydrarna/bin/pip install --no-cache-dir \
        "hydra-core>=1.0.7,<1.1" \
        "omegaconf>=2.0.5,<2.1" \
        cffi \
        regex \
        "sacrebleu>=1.4.12" \
        bitarray \
        scikit-learn

# Runtime deps not pulled in by fairseq/mamba-ssm.
# Pin triton==2.3.0 — the exact version torch 2.3.1 was built and tested with.
# A newer triton (2.3.1) is pulled in transitively but can JIT-compile PTX that
# the container's ptxas (CUDA 11.8) or a mismatched system ptxas cannot handle.
RUN /opt/conda/envs/hydrarna/bin/pip install --no-cache-dir \
        "transformers==4.44.0" \
        "triton==2.3.0" \
        tqdm tensorboardX pysam packaging

# Download base-model weights (336 MB) from Zenodo; copy dict/ alongside so the
# wrapper can reference both from /opt/hydrarna_weights/. No runtime fetch needed.
RUN mkdir -p /opt/hydrarna_weights && \
    wget -q -O /opt/hydrarna_weights/HydraRNA_model.pt \
        "https://zenodo.org/records/20481998/files/HydraRNA_model.pt" && \
    cp -r /opt/hydrarna_repo/dict /opt/hydrarna_weights/dict

# Copy CLI wrapper
COPY bin/hydrarna_predict.py /opt/bin/hydrarna_predict.py
RUN chmod +x /opt/bin/hydrarna_predict.py
ENV PATH="/opt/bin:$PATH"

ENV HF_HOME=/tmp/hf_cache
ENV HF_HUB_OFFLINE=1
# fairseq is importable directly from its source tree (no editable install).
# /opt/hydrarna_repo/fairseq is the repo subdirectory containing the fairseq/ package.
ENV PYTHONPATH="/opt/hydrarna_repo/fairseq:$PYTHONPATH"
# Force Triton to use the container's own ptxas (CUDA 11.8) rather than any
# system ptxas that Singularity --nv may expose from the host. Without this,
# a host with CUDA 12.x ptxas on PATH can produce PTX incompatible with the
# container's 11.8 runtime, causing exit code 2 at first kernel JIT.
ENV TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas

WORKDIR /opt/hydrarna_repo
