FROM condaforge/miniforge3:latest

LABEL org.opencontainers.image.source="https://github.com/oxpig/CaLM"
LABEL org.opencontainers.image.licenses="NOASSERTION"
LABEL org.opencontainers.image.title="calm-cpu"
LABEL org.opencontainers.image.description="Codon adaptation Language Model (Outeiral & Deane, NMI 2024) — CPU-only build. Code BSD-3-Clause; the weights carry no license statement."

RUN apt-get update && apt-get install -y --no-install-recommends git wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN mamba create -n calm -c pytorch -c conda-forge -y \
        python=3.10 \
        pytorch=2.2 \
        cpuonly \
        "numpy<2" \
        "setuptools<70" \
        pip \
    && mamba clean -afy

ENV PATH="/opt/conda/envs/calm/bin:$PATH"
ENV CONDA_DEFAULT_ENV=calm

# CaLM at a fixed commit (upstream's last, 2024-10-20), its dependencies held at the validated
# image's versions (see the constraints file).
COPY Dockerfiles/constraints/calm.txt /tmp/calm_constraints.txt
RUN git clone https://github.com/oxpig/CaLM.git /opt/calm_repo && \
    git -C /opt/calm_repo checkout -q 24187ea44744ca548b747ad262058f3463589f8e && \
    /opt/conda/envs/calm/bin/pip install --no-cache-dir --no-build-isolation \
        -c /tmp/calm_constraints.txt -e /opt/calm_repo

RUN mkdir -p /opt/calm_weights && \
    wget -q --tries=3 --timeout=120 \
        -O /opt/calm_weights/calm_weights.pkl \
        http://opig.stats.ox.ac.uk/data/downloads/calm_weights.pkl

COPY bin/calm_predict.py /opt/bin/calm_predict.py
RUN chmod +x /opt/bin/calm_predict.py
ENV PATH="/opt/bin:$PATH"

ENV HF_HOME=/tmp/hf_cache
ENV HF_HUB_OFFLINE=1

WORKDIR /opt
