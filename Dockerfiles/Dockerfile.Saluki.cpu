FROM tensorflow/tensorflow:2.12.0

RUN apt-get update && apt-get install -y --no-install-recommends \
        git wget unzip && \
    rm -rf /var/lib/apt/lists/*

# Clone basenji (contains Saluki model code, inference scripts, and dependencies) at a fixed
# commit; its model code (rnann.py, layers.py, blocks.py) is identical to the validated image's
ARG BASENJI_COMMIT=06ce5d387e20b47184d05433b3983163c5f923cd
RUN git init -q /opt/basenji && \
    git -C /opt/basenji remote add origin https://github.com/calico/basenji.git && \
    git -C /opt/basenji fetch -q --depth 1 origin ${BASENJI_COMMIT} && \
    git -C /opt/basenji checkout -q FETCH_HEAD

WORKDIR /opt/basenji

# Install basenji deps, then add the source to PYTHONPATH directly.
# `pip install .` (non-editable) doesn't copy source for this package, and
# `-e .` creates .egg-link that Docker layers don't preserve reliably.
# Versions held at the validated image's (see the constraints file).
COPY Dockerfiles/constraints/saluki.txt /tmp/saluki_constraints.txt
RUN pip install --no-cache-dir -r requirements.txt -c /tmp/saluki_constraints.txt
ENV PYTHONPATH="/opt/basenji:$PYTHONPATH"

# Download Saluki datasets.zip from Zenodo (~18.8 GB). Extract ONLY the model
# checkpoints + params.json (~250 MB across 100 .h5 files for 10 folds x
# 5 crosses x 2 heads). Discard training data and the zip.
# Model structure: f{0..9}_c{0..4}/train/model{0,1}_best.h5
#   head 0 = human, head 1 = mouse
RUN wget -q --show-progress -O /tmp/datasets.zip \
        "https://zenodo.org/records/6326409/files/datasets.zip?download=1" && \
    mkdir -p /opt/saluki_models && \
    cd /tmp && unzip -o datasets.zip \
        "datasets/deeplearning/train_gru/params.json" \
        "datasets/deeplearning/train_gru/f*_c*/train/model*_best.h5" \
    && mv /tmp/datasets/deeplearning/train_gru/* /opt/saluki_models/ \
    && rm -rf /tmp/datasets /tmp/datasets.zip

# Make models + output dirs writable for non-root Nextflow users
RUN chmod -R 755 /opt/saluki_models

# RNA-Zoo wrapper: sets the splice-junction channel from exon lengths
COPY bin/saluki_predict.py /opt/bin/saluki_predict.py
RUN chmod +x /opt/bin/saluki_predict.py
ENV PATH="/opt/bin:/opt/basenji/bin/archive:/opt/basenji/bin:$PATH"
WORKDIR /opt/basenji
