FROM condaforge/miniforge3:latest

RUN apt-get update && apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

RUN mamba create -n codontransformer -c pytorch -c conda-forge -y \
        python=3.10 \
        pytorch=2.2 \
        cpuonly \
        pip \
    && mamba clean -afy

ENV PATH="/opt/conda/envs/codontransformer/bin:$PATH"
ENV CONDA_DEFAULT_ENV=codontransformer

# Install CodonTransformer from PyPI
RUN /opt/conda/envs/codontransformer/bin/pip install --no-cache-dir CodonTransformer

# Bake the HuggingFace weights (~358 MB) into a plain directory under /opt, readable by any
# user, and point the wrapper at it. The HuggingFace cache is not used at run time: the
# default cache (/root/.cache) is unreadable to a non-root Singularity user, and the RNA-Zoo
# profiles redirect HF_HOME to /tmp, so a cached copy was never found and the model was
# downloaded again on every run.
RUN /opt/conda/envs/codontransformer/bin/python -c "\
from transformers import AutoTokenizer, BigBirdForMaskedLM; \
AutoTokenizer.from_pretrained('adibvafa/CodonTransformer').save_pretrained('/opt/codontransformer_model'); \
BigBirdForMaskedLM.from_pretrained('adibvafa/CodonTransformer').save_pretrained('/opt/codontransformer_model'); \
print('Model saved to /opt/codontransformer_model')" && \
    chmod -R a+rX /opt/codontransformer_model
ENV CODONTRANSFORMER_MODEL=/opt/codontransformer_model

# Copy our CLI wrapper script
COPY bin/codon_transformer_predict.py /opt/bin/codon_transformer_predict.py
RUN chmod +x /opt/bin/codon_transformer_predict.py
ENV PATH="/opt/bin:$PATH"

WORKDIR /opt
