/*
========================================================================================
    Test profile: minimal inputs for CI and local smoke tests.
    Only sets _input for models that complete in <60s on CPU.
    Models without _input set here are simply not run.
========================================================================================
*/

params {
    ribonn_input            = "${projectDir}/tests/data/ribonn_prediction_input.txt"
    rnafm_input             = "${projectDir}/tests/data/rnafm_test.fa"
    rinalmo_input           = "${projectDir}/tests/data/rnafm_test.fa"
    ernierna_input          = "${projectDir}/tests/data/rnafm_test.fa"
    rnaernie_input          = "${projectDir}/tests/data/rnaernie_test.fa"
    plantrnafm_input        = "${projectDir}/tests/data/rnafm_test.fa"
    splicebert_input        = "${projectDir}/tests/data/splicebert_test.fa"

    // SpliceAI synthetic mini-genome smoke fixture
    spliceai_vcf                  = "${projectDir}/tests/data/spliceai/test_variants.vcf"
    spliceai_reference_fasta      = "${projectDir}/tests/data/spliceai/mini_ref.fa"
    spliceai_annotation           = "${projectDir}/tests/data/spliceai/mini_anno.tsv"

    // Pangolin synthetic mini-genome smoke fixture
    pangolin_variants             = "${projectDir}/tests/data/pangolin/test_variants.vcf"
    pangolin_reference_fasta      = "${projectDir}/tests/data/pangolin/mini_ref.fa"
    pangolin_annotation_db        = "${projectDir}/tests/data/pangolin/mini_annotation.db"
    calm_input              = "${projectDir}/tests/data/rnafm_test.fa"
    mrnabert_input          = "${projectDir}/tests/data/rnafm_test.fa"
    codontransformer_input  = "${projectDir}/tests/data/codontransformer_test.fa"
    saluki_input            = "${projectDir}/tests/data/saluki_test.fa"
    translationai_input     = "${projectDir}/tests/data/translationai_test.fa"
    utrlm_input             = "${projectDir}/tests/data/utrlm_test.fa"
    multirm_input           = "${projectDir}/tests/data/multirm_test.fa"
    spotrna_input           = "${projectDir}/tests/data/spotrna_test.fa"

    ribotie_input           = "${projectDir}/tests/data/ribotie"
    ribotie_config          = "${projectDir}/tests/data/ribotie_config.yml"
    ribotie_max_epochs      = 1
    ribotie_patience        = 1

    // Riboformer: external-input mode — a ~2 MB subsample of the E. coli
    // Mg_buffer dataset (first 100 kb of NC_000913.2). Exercises the
    // cp-staging code path in modules/local/riboformer.nf. Bundled-mode
    // (--riboformer_bundled_dataset) is still available for users;
    // see docs/models/Riboformer.md.
    riboformer_input           = "${projectDir}/tests/data/riboformer"
    riboformer_reference_wig   = "GSM3358138_filter_Cm_ctrl"
    riboformer_target_wig      = "GSM3358140_freeze_Mg_ctrl"
    riboformer_model           = "bacteria_cm_mg"

    // RiboNN and UTR-LM fine-tuning on 200 synthetic rows each, with the fewest epochs that
    // still run every step: two RiboNN folds (the second starts after the first fold's
    // held-out predictions) with one epoch per phase, and two UTR-LM epochs. This checks
    // that the modules run, not what they learn.
    ribonn_finetune_input         = "${projectDir}/tests/data/ribonn_finetune.tsv"
    ribonn_finetune_target        = 'TE_test'
    ribonn_finetune_folds         = 2
    ribonn_finetune_phase1_epochs = 1
    ribonn_finetune_phase2_epochs = 1
    ribonn_finetune_patience      = 1

    utrlm_finetune_input          = "${projectDir}/tests/data/utrlm_finetune.csv"
    utrlm_finetune_label          = 'mrl_test'
    utrlm_finetune_epochs         = 2
    utrlm_finetune_patience       = 1

    // Not tested under -profile test (too slow or special requirements):
    //   rhofold     — ~5 min on CPU      (covered by -profile test_gpu)

    outdir                  = 'results_test'
}
