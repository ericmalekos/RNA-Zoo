/*
========================================================================================
    Singularity smoke-test profile: 5 representative models across 5 tracks.
    Kept small so all images fit within GHA runner disk limits (~14 GB usable).
    Use with: nextflow run . -profile test_singularity,singularity,cpu

    Images pulled (~7.5 GB total compressed):
      ribonn-cpu      ~1.2 GB   Translation  — TSV input, multi-column output
      rnafm-cpu       ~1.7 GB   Foundation   — FASTA → embeddings
      splicebert-cpu  ~1.2 GB   Splicing     — pip-installed torch (recently fixed)
      multirm-cpu     ~1.0 GB   Modification — 12-class FASTA predictor
      utrlm-cpu       ~2.4 GB   mRNA Design  — complex workflow with task param
========================================================================================
*/

params {
    ribonn_input    = "${projectDir}/tests/data/ribonn_prediction_input.txt"
    rnafm_input     = "${projectDir}/tests/data/rnafm_test.fa"
    splicebert_input = "${projectDir}/tests/data/splicebert_test.fa"
    multirm_input   = "${projectDir}/tests/data/multirm_test.fa"
    utrlm_input     = "${projectDir}/tests/data/utrlm_test.fa"

    outdir          = 'results_test'
}
