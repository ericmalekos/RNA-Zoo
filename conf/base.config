/*
========================================================================================
    Resources and thread limits applied to every process
========================================================================================
    Without a cpus setting each task was given one CPU by Nextflow, while PyTorch,
    TensorFlow and the BLAS libraries inside the containers started one thread per core of
    the node (hundreds on a cluster node). Every task now asks for params.task_cpus CPUs, and
    the engine profiles in nextflow.config export the matching thread limits INSIDE the
    container through containerOptions (an env block or beforeScript does not reach it).
*/

process {
    cpus = { params.task_cpus as int }
}
